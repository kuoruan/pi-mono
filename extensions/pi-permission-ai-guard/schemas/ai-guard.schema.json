{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kuoruan/pi-mono/master/extensions/pi-permission-ai-guard/schemas/ai-guard.schema.json",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "default": "off"
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 300000,
      "default": 15000
    },
    "mode": {
      "type": "string",
      "enum": ["strict", "default", "advisory", "lenient", "permissive"],
      "default": "default",
      "description": "The leniency ladder for the reviewer's non-allow verdicts, strictest first. Hard-tier denies (riskLevel high|critical, or missing) always deny. Soft-tier denies (low|medium) and the model's own uncertainty map per mode: 'strict' — both deny, the reviewer's allow is the only pass; 'default' — deny soft denies, uncertainty asks; 'advisory' — both ask, you decide everything the reviewer doesn't allow; 'lenient' — soft denies ask, uncertainty passes; 'permissive' — both pass, only hard-tier denies block. Reviewer machinery failures never map to allow: they deny under strict and permissive, and defer otherwise."
    },
    "circuitBreaker": {
      "type": "object",
      "properties": {
        "consecutive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 3
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        },
        "verdict": {
          "type": "string",
          "enum": ["deny", "defer"],
          "default": "deny"
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "maxEntries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 128
        }
      },
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "maxUserMessages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "maxCharsPerEntry": {
          "type": "integer",
          "minimum": 100,
          "maximum": 20000,
          "default": 1000
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": ["bash", "mcp", "skill"]
    },
    "instructions": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": ["provider", "model"],
  "additionalProperties": false
}
