{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#src/*": ["./src/*"],
      "#test/*": ["./tests/*"]
    }
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts"]
}
